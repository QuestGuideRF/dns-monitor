# Конфигурационный файл для DNS Monitor

# Настройки DNS-сервера
DNS_PORT=5353
DNS_UPSTREAM=8.8.8.8
DNS_HOST=0.0.0.0

# Настройки веб-сервера
WEB_PORT=5000
WEB_HOST=0.0.0.0
WEB_DEBUG=True

# База данных
DB_PATH=dns_logs.db

# Блок-лист
BLOCKLIST_PATH=blocklist.txt

# Лимиты
MAX_QUERIES_IN_MEMORY=10000
AUTO_CLEANUP_DAYS=30

# Логирование
LOG_LEVEL=INFO
LOG_FILE=dns_monitor.log



